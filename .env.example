# UniNexus AI — Environment Configuration
# Copy this file to .env and replace placeholder values.

APP_NAME="UniNexus AI"
ENVIRONMENT="development"

# Database
DATABASE_URL="sqlite:///./uninexus.db"

# Security
# Change this before any non-demo deployment.
SECRET_KEY="change-this-development-secret"

# LLM provider: groq, gemini, or ollama
LLM_PROVIDER="groq"

# Groq
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"

# Google Gemini
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-latest"

# Local Ollama
# Set this to a model actually installed on your machine.
OLLAMA_MODEL="llama3.2:3b"

# Local embeddings
# The application uses Ollama's nomic-embed-text model for document embeddings.
